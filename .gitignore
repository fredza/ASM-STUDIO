/target
# Artefacts d'assemblage des exemples (.o, .lst, binaires ELF)
/build
/.junie
/examples

/.claude/worktrees
# État local de l'outillage, jamais du projet : les permissions accordées à
# Claude Code sur cette machine, et les onglets que l'IDE réécrit à chaque
# changement de focus. `.claude/settings.json` — le réglage partagé — resterait
# suivi s'il apparaissait un jour : seule la variante `.local` est ignorée.
/.claude/settings.local.json
/.idea/claudeCodeEditorTabs.xml
/.idea/claudeCodeTabState.xml
# Archives de distribution produites par install/package.sh
/dist
# Notes de travail sur le système de licence : documents internes, que le
# changelog interne demande lui-même de ne pas publier tel quel. Ils restent
# sur le disque, hors du dépôt. Le guide de démarrage rapide, lui, est
# destiné à l'utilisateur final et reste suivi.
/doc/LICENCE-SYSTEME-INTERNE.md
/doc/TEST-LICENCE.md
/doc/CHANGELOG-LICENCE-INTERNE.md

# Compteur de builds, incrémenté par build.rs à chaque compilation. Local à la
# machine : le suivre en versionné salirait le dépôt à chaque « cargo build »
# et entrerait en conflit à chaque fusion. Ce qui identifie une livraison, ce
# sont la version et le commit ; le numéro de build distingue les compilations.
/build-number.txt
